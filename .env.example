# development, testing, atau production
CI_ENV=development

# Kredensial database. Salin ke .env dan isi. Jangan memakai akun root
# MySQL untuk produksi; buat akun khusus dengan privilege minimum:
#
#   CREATE USER 'garuda_cbt'@'localhost' IDENTIFIED BY 'ganti-password-kuat';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `garuda_cbt_development`.* TO 'garuda_cbt'@'localhost';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `garuda_cbt_production`.* TO 'garuda_cbt'@'localhost';
#
# Migrasi skema, installer, backup, dan restore membutuhkan akun dengan
# hak DDL/CREATE DATABASE. Jalankan dengan akun admin terpisah, jangan
# simpan kredensial admin di .env aplikasi.
#
# Nilai dengan spasi/tanda kutip sebaiknya dibungkus tanda kutip ganda.
# DB_HOSTNAME=localhost
# DB_USERNAME=garuda_cbt
# DB_PASSWORD="ganti-password-kuat"
# DB_DATABASE_DEVELOPMENT=garuda_cbt_development
# DB_DATABASE_PRODUCTION=garuda_cbt_production

# Reverse proxy / Cloudflare Tunnel. Hanya alamat di sini yang boleh
# menyetel X-Forwarded-Proto. Kosongkan bila Apache menerima koneksi
# langsung. Contoh: 127.0.0.1,10.0.0.0/8
# APP_TRUSTED_PROXIES=

# Allowlist host publik. Bila diisi, Host di luar daftar diganti host
# pertama supaya URL/redirect/hash SEB tidak bisa diracuni.
# APP_ALLOWED_HOSTS=cbt.sekolah.sch.id

# Reset kata sandi lewat email. Default mati: pengguna diarahkan ke
# administrator. Isi 1 dan lengkapi SMTP untuk mengaktifkan.
# AUTH_EMAIL_ENABLED=0
# AUTH_SMTP_HOST=smtp.gmail.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=
# AUTH_SMTP_CRYPTO=tls